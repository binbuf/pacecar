<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Pacecar.Sensors</AssemblyName>
    <RootNamespace>Pacecar.Sensors</RootNamespace>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained so the helper does not depend on the native app's static CRT or vcpkg
         artifacts. AOT is not enabled: LibreHardwareMonitorLib uses WMI/dynamic code. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- PawnIO-based LibreHardwareMonitor (MPL-2.0). Never WinRing0 (0.9.4 and earlier). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Real-time ETW session control/consumption for the opt-in FPS capture (T17). The managed
         wrapper avoids hand-rolled EVENT_TRACE_LOGFILE/EVENT_RECORD interop in an elevated process. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.23" />
  </ItemGroup>

</Project>